rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection: public read for all visitors, write for admin management
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Blogs collection: public read for articles, write for admin management
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if true;
    }

    // Leads collection: public create for contact forms, read/update/delete for admin
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // General fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

